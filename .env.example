# ==========================================
# SIGAP — Secret untuk Docker Compose (root .env)
# ==========================================
# File ini dibaca otomatis oleh `docker compose` untuk substitusi variabel di
# docker-compose.yml (secret management). SALIN ke `.env` dan isi nilai asli.
# JANGAN commit `.env` (sudah di-.gitignore).

# ---- PostgreSQL (harus cocok dengan DB_USER/DB_PASSWORD di backend/.env.docker) ----
POSTGRES_USER=sigap_user
# WAJIB diisi: docker compose akan menolak up bila kosong (sintaks ${VAR:?})
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_DB_AMAN
POSTGRES_DB=sigap_db

# ---- Redis (opsional; Task 7.2) ----
# Bila dikosongkan, Redis berjalan tanpa AUTH (hanya aman di jaringan internal).
# Bila diisi, HARUS sama dengan REDIS_PASSWORD di backend/.env.docker.
REDIS_PASSWORD=

# ---- Logging (Task 7.6) ----
# Level log default untuk service api. Nilai: debug | info | warn | error.
# Diteruskan ke container api sebagai variabel environment LOG_LEVEL.
LOG_LEVEL=info

# ==========================================
# Docker Secrets (Task 7.5 — Container Hardening)
# ==========================================
# Secret untuk container api dikirim sebagai FILE Docker secret, bukan env var.
# Buat file secret LOKAL di direktori `secrets/` (JANGAN commit ke git):
#   mkdir -p secrets
#   printf '%s' 'PASSWORD_DB_AMAN'        > secrets/db_password
#   printf '%s' 'JWT_SECRET_AMAN'         > secrets/jwt_secret
#   printf '%s' 'AES_SECRET_KEY_256_BIT'  > secrets/aes_secret_key
#   chmod 600 secrets/*
# Docker mem-mount file-file ini ke /run/secrets/<nama> di dalam container api,
# lalu dibaca oleh backend/utils/secrets.go. Nilai pada backend/.env.docker
# hanya dipakai sebagai FALLBACK untuk development di luar Docker.
