# ==========================================
# SIGAP — Secret untuk Docker Compose (root .env)
# ==========================================
# File ini dibaca otomatis oleh `docker compose` untuk substitusi variabel di
# docker-compose.yml (secret management). SALIN ke `.env` dan isi nilai asli.
# JANGAN commit `.env` (sudah di-.gitignore).

# ---- PostgreSQL (harus cocok dengan DB_USER/DB_PASSWORD di backend/.env.docker) ----
POSTGRES_USER=sigap_user
# WAJIB diisi: docker compose akan menolak up bila kosong (sintaks ${VAR:?})
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_DB_AMAN
POSTGRES_DB=sigap_db

# ---- Redis (opsional; Task 7.2) ----
# Bila dikosongkan, Redis berjalan tanpa AUTH (hanya aman di jaringan internal).
# Bila diisi, HARUS sama dengan REDIS_PASSWORD di backend/.env.docker.
REDIS_PASSWORD=
