# ==========================================
# Konfigurasi Database
# ==========================================
DB_HOST=db
DB_PORT=5432
DB_USER=sigap_user
DB_PASSWORD=sigap_password_aman
DB_NAME=sigap_db

# ==========================================
# Konfigurasi JWT
# ==========================================
# Ganti dengan secret yang kuat dan unik untuk produksi!
JWT_SECRET=sigap_jwt_secret_ganti_di_produksi

# ==========================================
# Konfigurasi Connection Pool (opsional, ada fallback default)
# ==========================================
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30
DB_CONN_MAX_IDLE_TIME=10
