# ==========================================
# Konfigurasi Database
# ==========================================
DB_HOST=db
DB_PORT=5432
DB_USER=sigap_user
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DB_AMAN
DB_NAME=sigap_db

# ==========================================
# Konfigurasi Redis (Task 7.2)
# ==========================================
# Host/nama service Redis di docker-compose. Di luar Docker, set REDIS_HOST
# ke host Redis (mis. 127.0.0.1) atau biarkan string kosong → fallback
# in-memory untuk rate-limit & blacklist.
REDIS_HOST=redis
REDIS_PORT=6379
# Opsional — harus cocok dengan REDIS_PASSWORD di root .env bila diisi.
REDIS_PASSWORD=

# ==========================================
# Konfigurasi JWT & Enkripsi
# ==========================================
# CATATAN (Task 7.5 — Container Hardening):
# Di dalam container Docker, DB_PASSWORD, JWT_SECRET, dan AES_SECRET_KEY
# TIDAK lagi dibaca dari env var melainkan dari Docker secret sebagai FILE
# di /run/secrets/<nama> (lihat docker-compose.yml & backend/utils/secrets.go).
# Baris di bawah ini hanya dipakai sebagai FALLBACK saat di luar Docker
# (development lokal) — aplikasi memprioritaskan file secret bila ada.
# Ganti dengan secret yang kuat dan unik untuk produksi!
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DB_AMAN
JWT_SECRET=GANTI_DENGAN_JWT_SECRET_KEY_ANDA
AES_SECRET_KEY=GANTI_DENGAN_AES_SECRET_KEY_256_BIT_ANDA

# ==========================================
# Konfigurasi Web Push / VAPID (Task 8.3)
# ==========================================
# VAPID untuk notifikasi push browser. Bila kosong, push dinonaktifkan
# (fallback ke notifikasi in-app). Generate VAPID keys sesuai dokumentasi
# library webpush-go (mis. melalui contoh GenerateVAPIDKeys).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=operator@sigap.id

# ==========================================
# Konfigurasi Email / SMTP (Task 11.3, Sprint 27)
# ==========================================
# SMTP untuk notifikasi email. Bila kosong, email dinonaktifkan
# (fallback ke notifikasi in-app + push).
#
# Contoh dengan Hostinger (email noreply@nexaspace.site):
#   SMTP_HOST=smtp.hostinger.com
#   SMTP_PORT=587
#   SMTP_USER=noreply@nexaspace.site
#   SMTP_PASSWORD=<password email>
#   SMTP_FROM=SIGAP <noreply@nexaspace.site>
#   SMTP_TLS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SIGAP <noreply@sigap.id>
SMTP_TLS=true

# ==========================================
# Konfigurasi Logging (Task 7.6)
# ==========================================
# Level log untuk logger terstruktur. Nilai: debug | info | warn | error.
# Default (bila kosong) = info.
LOG_LEVEL=info

# ==========================================
# Konfigurasi Keamanan Seeder
# ==========================================
# Password admin default, HANYA digunakan saat akun 'admin' dibuat pertama kali.
# Setelah akun admin dibuat, password tidak akan di-reset ulang oleh seeder.
# Wajib minimal 8 karakter. WAJIB diisi sebelum menjalankan server pada DB baru.
ADMIN_DEFAULT_PASSWORD=GANTI_DENGAN_PASSWORD_ADMIN_AWAL_ANDA

# ==========================================
# Konfigurasi Environment
# ==========================================
# Nilai: development | staging | production
# production: Menonaktifkan Swagger UI dan endpoint test-panic
APP_ENV=production

# Zona waktu operasional untuk batas "hari ini" pada ringkasan Log CCTV.
# Gunakan nama zona IANA. Default Asia/Makassar (WITA).
APP_TIMEZONE=Asia/Makassar

# Retensi log event CCTV dalam hari. Worker cleanup berjalan setiap 24 jam dan
# menghapus log lebih tua dari nilai ini secara bertahap (1.000 baris/batch).
# Nilai kosong, bukan angka, atau <= 0 memakai default 90 hari.
CCTV_STREAM_LOG_RETENTION_DAYS=90

# Catat event standby saat kamera idle menunggu penonton. Default false agar
# log tidak dibanjiri event rutin; status stream tetap diperbarui.
CCTV_LOG_STANDBY_EVENTS=false

# ==========================================
# Konfigurasi Connection Pool (opsional, ada fallback default)
# ==========================================
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30
DB_CONN_MAX_IDLE_TIME=10

# ==========================================
# Konfigurasi CORS (pisahkan banyak origin dengan koma)
# ==========================================
CORS_ALLOWED_ORIGINS=https://localhost

# ==========================================
# Konfigurasi Trusted Proxy (keamanan)
# ==========================================
# Daftar IP/CIDR proxy yang dipercaya (pisahkan dengan koma). Header
# X-Forwarded-For hanya dipercaya dari koneksi di daftar ini; entri yang bukan
# IP/CIDR valid dibuang dengan warning. Kosongkan bila API diakses langsung
# (default aman). Di docker-compose, IP statis reverse proxy Nginx adalah
# 172.28.0.10 (lihat networks di docker-compose.yml), dan Nginx menimpa
# X-Forwarded-For dengan $remote_addr (bukan append).
TRUSTED_PROXY_IPS=172.28.0.10

# ==========================================
# Monitoring Insiden CCTV & Telegram (Revisi 3)
# ==========================================
# Aktifkan hanya setelah uji staging terkendali siap dan migrasi 000034 terpasang.
# Default false menjaga agar tidak ada tiket otomatis/pesan Telegram yang terkirim.
CCTV_INCIDENTS_ENABLED=false
# Interval siklus verifier mode insiden (detik, rentang valid 30-120; default 60).
CCTV_INCIDENT_INTERVAL_SECONDS=60
# Batas total sesi RTSP upstream gabungan di UnifiedNVRSessionGate (1-64; default 10).
CCTV_MAX_UPSTREAM_SLOTS=10
# Batas konkurensi probe kamera GSM di UnifiedNVRSessionGate (1-10; default 2).
CCTV_GSM_MAX_CONCURRENT=2
# Jeda antar start slot pacer gate (ms, rentang 100-10000; default 1250).
CCTV_VERIFY_PACE_MS=1250
# Batas tunggu verifikasi manual / reaktivasi di gate (ms, rentang 50-60000; default 15000).
CCTV_MANUAL_VERIFY_WAIT_TIMEOUT_MS=15000
# Ambang pengingat penugasan & eskalasi belum pulih (menit). Staging dapat memakai nilai kecil (mis. 1 dan 2).
CCTV_INCIDENT_REMINDER_MINUTES=30
CCTV_INCIDENT_ESCALATION_MINUTES=240
# Routing Telegram Bot (WAJIB pakai bot & grup SANDBOX/UJI saat staging; JANGAN commit token/ID nyata).
TELEGRAM_BOT_TOKEN=
# Peta JSON site_id -> chat_id grup teknisi (ops_group), contoh: {"<site_uuid>":"-1001234567890"}
TELEGRAM_SITE_CHATS_JSON={}
# Peta JSON site_id -> chat_id grup admin (admin_group), contoh: {"<site_uuid>":"-1009876543210"}
TELEGRAM_SITE_ADMIN_CHATS_JSON={}
# Fallback chat_id grup admin bila site belum tercantum di TELEGRAM_SITE_ADMIN_CHATS_JSON
TELEGRAM_ADMIN_CHAT_ID=
