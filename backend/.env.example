# ==========================================
# Konfigurasi Database
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=ganti_dengan_password_db_lokal_anda
DB_NAME=sigap_db

# ==========================================
# Konfigurasi JWT & Enkripsi
# ==========================================
# Ganti dengan secret key yang kuat dan unik!
JWT_SECRET=ganti_dengan_jwt_secret_key_anda
AES_SECRET_KEY=ganti_dengan_aes_secret_key_256_bit_anda

# ==========================================
# Konfigurasi Keamanan Seeder
# ==========================================
# Password admin default, HANYA digunakan saat akun 'admin' dibuat pertama kali
# (database kosong). Setelah akun admin dibuat, password tidak akan di-reset
# ulang oleh seeder pada setiap startup. Wajib minimal 8 karakter.
# WAJIB diisi sebelum menjalankan server pada database baru.
ADMIN_DEFAULT_PASSWORD=ganti_dengan_password_admin_awal_anda

# ==========================================
# Konfigurasi Environment
# ==========================================
# Nilai: development | staging | production
# - development: Swagger UI aktif, endpoint test-panic aktif
# - production: Swagger UI dinonaktifkan, endpoint test-panic dinonaktifkan
APP_ENV=development

# Zona waktu operasional untuk batas "hari ini" pada ringkasan Log CCTV.
# Gunakan nama zona IANA. Default Asia/Makassar (WITA).
APP_TIMEZONE=Asia/Makassar

# Retensi log event CCTV dalam hari. Worker cleanup berjalan setiap 24 jam dan
# menghapus log lebih tua dari nilai ini secara bertahap (1.000 baris/batch).
# Nilai kosong, bukan angka, atau <= 0 memakai default 90 hari.
CCTV_STREAM_LOG_RETENTION_DAYS=90

# Catat event standby saat kamera idle menunggu penonton. Default false agar
# log tidak dibanjiri event rutin; status stream tetap diperbarui.
CCTV_LOG_STANDBY_EVENTS=false

# ==========================================
# Konfigurasi CORS
# ==========================================
# Daftar origin yang diizinkan mengakses API (pisahkan dengan koma)
CORS_ALLOWED_ORIGINS=http://localhost:3001

# ==========================================
# Konfigurasi Trusted Proxy (keamanan)
# ==========================================
# Daftar IP/CIDR proxy yang dipercaya (pisahkan dengan koma). Hanya koneksi
# dari daftar ini yang header X-Forwarded-For-nya dipercaya untuk rate limiting
# dan audit log. Entri yang bukan IP/CIDR valid akan dibuang dengan warning.
# KOSONGKAN bila API diakses langsung (default aman).
# Contoh di belakang Nginx: TRUSTED_PROXY_IPS=127.0.0.1,172.18.0.0/16
# Pastikan reverse proxy menimpa X-Forwarded-For (bukan append) dengan IP klien.
TRUSTED_PROXY_IPS=

# ==========================================
# Konfigurasi Web Push VAPID (Task 8.3)
# ==========================================
# Generate pasangan kunci VAPID baru milik Anda (JANGAN pakai contoh di bawah).
# Bila dikosongkan, push dinonaktifkan (fallback ke notifikasi in-app).
# Buat pasangan unik untuk tiap environment; jangan memakai contoh/shared key.
# Public key P-256 wajib 65 byte (base64url umumnya 87 karakter).
# Generate dari folder backend: go run ./cmd/vapid-keygen
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@sigap.local

# ==========================================
# Konfigurasi Streaming RTSP (Fase 9)
# ==========================================
# Isi dengan host/user NVR Hikvision milik Anda (contoh generik, bukan host asli).
RTSP_NVR_HOST=192.168.1.100
RTSP_NVR_PORT=554
RTSP_NVR_USER=GANTI_NVR_USER
MEDIAMTX_API_URL=http://localhost:9997

# Asisten AI: gateway yang mendukung endpoint embeddings dan chat completions.
# Jangan menyimpan kunci asli di Git. Gateway menerima pertanyaan pengguna dan
# kutipan dokumen kebutuhan proyek; jangan masukkan informasi sensitif.
AI_GATEWAY_URL=
AI_GATEWAY_KEY=
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=

# ==========================================
# Monitoring Insiden CCTV & Telegram (Revisi 3)
# ==========================================
# Default false agar pengembangan lokal tidak membuka tiket otomatis/Telegram.
CCTV_INCIDENTS_ENABLED=false
CCTV_INCIDENT_INTERVAL_SECONDS=60
CCTV_MAX_UPSTREAM_SLOTS=10
CCTV_GSM_MAX_CONCURRENT=2
CCTV_VERIFY_PACE_MS=1250
CCTV_MANUAL_VERIFY_WAIT_TIMEOUT_MS=15000
CCTV_INCIDENT_REMINDER_MINUTES=30
CCTV_INCIDENT_ESCALATION_MINUTES=240
# Routing Telegram (pakai bot & grup sandbox uji saat pengujian terintegrasi)
TELEGRAM_BOT_TOKEN=
TELEGRAM_SITE_CHATS_JSON={}
TELEGRAM_SITE_ADMIN_CHATS_JSON={}
TELEGRAM_ADMIN_CHAT_ID=
