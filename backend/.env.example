# ==========================================
# Konfigurasi Database
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=ganti_dengan_password_db_lokal_anda
DB_NAME=sigap_db

# ==========================================
# Konfigurasi JWT & Enkripsi
# ==========================================
# Ganti dengan secret key yang kuat dan unik!
JWT_SECRET=ganti_dengan_jwt_secret_key_anda
AES_SECRET_KEY=ganti_dengan_aes_secret_key_256_bit_anda

# ==========================================
# Konfigurasi Keamanan Seeder
# ==========================================
# Password admin default, HANYA digunakan saat akun 'admin' dibuat pertama kali
# (database kosong). Setelah akun admin dibuat, password tidak akan di-reset
# ulang oleh seeder pada setiap startup. Wajib minimal 8 karakter.
# WAJIB diisi sebelum menjalankan server pada database baru.
ADMIN_DEFAULT_PASSWORD=ganti_dengan_password_admin_awal_anda

# ==========================================
# Konfigurasi Environment
# ==========================================
# Nilai: development | staging | production
# - development: Swagger UI aktif, endpoint test-panic aktif
# - production: Swagger UI dinonaktifkan, endpoint test-panic dinonaktifkan
APP_ENV=development

# ==========================================
# Konfigurasi CORS
# ==========================================
# Daftar origin yang diizinkan mengakses API (pisahkan dengan koma)
CORS_ALLOWED_ORIGINS=http://localhost:3001

# ==========================================
# Konfigurasi Trusted Proxy (keamanan)
# ==========================================
# Daftar IP proxy yang dipercaya (pisahkan dengan koma). Hanya proxy di daftar
# ini yang header X-Forwarded-For / X-Real-IP-nya dipercaya untuk rate limiting
# dan audit log. KOSONGKAN bila API diakses langsung (default aman).
# Contoh di belakang Nginx/frontend Next.js: TRUSTED_PROXY_IPS=127.0.0.1,172.18.0.1
TRUSTED_PROXY_IPS=

# ==========================================
# Konfigurasi Streaming RTSP (Fase 9)
# ==========================================
RTSP_NVR_HOST=36.91.27.35
RTSP_NVR_PORT=554
RTSP_NVR_USER=admin
MEDIAMTX_API_URL=http://localhost:9997
